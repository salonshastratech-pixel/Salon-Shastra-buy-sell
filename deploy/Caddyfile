# /etc/caddy/Caddyfile — automatic HTTPS (Let's Encrypt). Replace the domain.
teamos.salonshastra.com {
    encode gzip
    request_body {
        max_size 6MB
    }
    reverse_proxy 127.0.0.1:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
    log {
        output file /var/log/caddy/teamos-access.log
    }
}
