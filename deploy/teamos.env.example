# /etc/teamos/teamos.env — owned by root, mode 640, group teamos. NEVER commit real values.
APP_ENV=production
SECRET_KEY=<64 random hex chars: python3 -c "import secrets;print(secrets.token_hex(32))">
DATABASE_URL=postgresql://teamos:<db password>@127.0.0.1:5432/teamos
COOKIE_SECURE=1
MFA_REQUIRED_ROLES=super_admin,finance
SESSION_IDLE_MINUTES=240
SESSION_ABSOLUTE_HOURS=12
LOG_LEVEL=INFO
