APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
# Production: postgresql://teamos:PASSWORD@127.0.0.1:5432/teamos
DATABASE_URL=sqlite:///instance/teamos.db
SESSION_IDLE_MINUTES=240
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=0
# Two-step sign-in is required for these roles. Leave empty ONLY for local demos.
MFA_REQUIRED_ROLES=super_admin,finance
# Optional: Fernet key to encrypt SQLite backups
# BACKUP_KEY=
LOG_LEVEL=INFO
# Fernet key that encrypts uploaded documents at rest. Required for uploads (they are refused without it).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILES_KEY=
# Public address customers use to open form links (defaults to the request host)
PUBLIC_BASE_URL=
